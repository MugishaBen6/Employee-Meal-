# ==============================================================================
# EMPLOYEE MEAL MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# Copy this file to .env for local overrides, or set these variables in your
# cloud deployment dashboard (e.g., Render for Backend, Vercel for Frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Spring Boot / Render)
# ------------------------------------------------------------------------------
# Port assigned dynamically by cloud provider (Render/Railway default is injected)
PORT=8080

# PostgreSQL Database Connection URL
# Local: jdbc:postgresql://localhost:5432/employee_meal_db
# Cloud (Neon/Supabase): jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/employee_meal_db
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# JWT Signing Secret (Must be a 64+ character random hex string in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Production Frontend URL (Used by backend for CORS and Password Reset emails)
# Local: http://127.0.0.1:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://127.0.0.1:5173

# SMTP Email Configuration (For Password Reset Email Dispatches)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@company.com

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (React + Vite / Vercel)
# ------------------------------------------------------------------------------
# Base API URL pointing to the Spring Boot backend
# Local Dev (uses Vite proxy): (leave empty or set to /api)
# Production (Vercel): https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=
